{
  "name": "debug-cli-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "expo start --port 8087",
    "web": "expo start --web --port 8087",
    "ios": "expo start --ios --port 8087",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "type-check": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "reset": "node scripts/reset.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src App.tsx index.ts",
    "test:browser": "playwright test --grep-invert @acceptance",
    "accept": "playwright test --grep @acceptance",
    "accept:ios": "maestro test maestro/submit.yaml",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js,json,yml,yaml}\"",
    "debug": "node debug-cli/cli.mjs",
    "test:challenge": "node scripts/verify-challenge.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reduxjs/toolkit": "2.11.2",
    "expo": "55.0.31",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "5.6.2",
    "react-native-web": "0.21.2",
    "react-redux": "9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.10",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "1.61.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "ws": "8.21.0"
  },
  "description": "Build a debug CLI for a deliberately broken Expo web/iOS todo app.",
  "license": "MIT"
}
