# Web and iOS Simulator can use the default loopback backend.
# Physical iPhone on the same LAN: replace with this Mac's LAN address,
# start the backend with DEMO_API_HOST=0.0.0.0, and restart Metro.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4310
# DEMO_API_HOST=0.0.0.0
# DEMO_WEB_ORIGIN=http://192.168.1.100:8087
